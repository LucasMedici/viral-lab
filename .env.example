# ============================================================================
# ViralLab — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as mesmas na Vercel
# (Project Settings › Environment Variables › Production).
# Nunca commite o .env.local.
# ============================================================================

# --- Supabase (Project Settings › API Keys / Data API) ----------------------
# URL do projeto, ex.: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Em projetos com chaves legadas, use a "anon public".
# É pública por design: a proteção dos dados vem do Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Cloudflare R2 (R2 › Manage API Tokens) ---------------------------------
# Account ID (aparece na página do R2 e na URL do painel)
R2_ACCOUNT_ID=
# Access Key ID e Secret Access Key do token S3 (mostrados só uma vez ao criar)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nome do bucket
R2_BUCKET=virallab
# Limite do plano gratuito, usado no indicador de uso (10 GB = 10737418240)
R2_FREE_TIER_BYTES=10737418240

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_TIMEZONE=America/Sao_Paulo
# Origens permitidas no CORS do bucket (usado por `npm run r2:cors`), separadas por vírgula
R2_CORS_ORIGINS=http://localhost:3000,https://virallab.vercel.app
